# Local (no Docker) development. scripts/dev.sh provisions all of this.
#
# 5434 is postgresql@15, chosen because it is the brew formula that ships the
# pgvector extension. 5432 is left to postgresql@14 for anything else on this
# machine. The Docker path overrides this value inside the container network,
# where the host is `postgres`, not localhost.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5434/codebase_rag
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENROUTER_API_KEY=
REPO_IDLE_TTL_HOURS=12
REPO_CLEANUP_INTERVAL_MINUTES=15
REPO_CLEANUP_ENABLED=true
